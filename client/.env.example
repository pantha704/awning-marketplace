# Awning web app configuration
# ---------------------------------------------------------------------------
# Local development needs nothing here: `npm run dev` proxies /api and /media
# to the API on port 4000.

# REQUIRED when the frontend is deployed separately from the API (the normal
# production setup). Public address of the API, no trailing slash.
# Example: https://awning-api.onrender.com
# It is read at BUILD time: set it before `npm run build`.
VITE_API_URL=

# Dev only: where `npm run dev` forwards API calls. Default http://localhost:4000
VITE_DEV_API_TARGET=
