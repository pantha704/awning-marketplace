# Awning server configuration
# ---------------------------------------------------------------------------
# The app boots with this file untouched: every value that still starts with
# REPLACE_ME is treated as "not set" and a local fallback is used instead.
# SETUP_GUIDE.md explains, step by step, how to get each real value.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Address of the web app (the frontend). Used for CORS and payment redirects.
# Several addresses can be separated with commas; the first is the main one.
CLIENT_URL=http://localhost:5173
# Public address of this API (the backend)
PUBLIC_URL=http://localhost:4000

# --- Auth (JWT) ---------------------------------------------------------------
# Long random string. `npm run setup` generates one for you.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# --- MongoDB ----------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/awning   Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/awning
MONGO_URI=mongodb://127.0.0.1:27017/awning
# Development only: if MONGO_URI is unreachable, start an embedded MongoDB (data in server/.data)
MONGO_MEMORY_FALLBACK=true
# Load the demo marketplace when the database is empty
AUTO_SEED=true

# --- Redis (carts and session caching) ----------------------------------------
# Local: redis://127.0.0.1:6379   Hosted: rediss://default:PASSWORD@host:6379
REDIS_URL=redis://127.0.0.1:6379
# auto = Redis when reachable, otherwise in-memory (development only) | redis | memory
CACHE_DRIVER=auto

# --- Elasticsearch (product search) ---------------------------------------------
# auto = Elasticsearch when ELASTICSEARCH_URL is set and reachable, otherwise MongoDB search | elasticsearch | mongo
SEARCH_DRIVER=auto
# Local: http://localhost:9200   Elastic Cloud: https://xxxx.es.region.cloud.es.io:443
ELASTICSEARCH_URL=REPLACE_ME_ELASTICSEARCH_URL
# Use EITHER an API key OR a username and password. Leave both as placeholders for an unsecured local node.
ELASTICSEARCH_API_KEY=REPLACE_ME_ELASTICSEARCH_API_KEY
ELASTICSEARCH_USERNAME=REPLACE_ME_ELASTICSEARCH_USERNAME
ELASTICSEARCH_PASSWORD=REPLACE_ME_ELASTICSEARCH_PASSWORD
ELASTICSEARCH_INDEX=awning_products

# --- AWS S3 (product images) ----------------------------------------------------
# auto = S3 when AWS_REGION and S3_BUCKET are real, otherwise local disk | s3 | local
STORAGE_DRIVER=auto
AWS_REGION=REPLACE_ME_AWS_REGION
AWS_ACCESS_KEY_ID=REPLACE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_ME_AWS_SECRET_ACCESS_KEY
S3_BUCKET=REPLACE_ME_S3_BUCKET_NAME
# Optional. Base URL images are read from, if not the bucket itself (for example a CloudFront domain: https://d123.cloudfront.net)
S3_PUBLIC_URL=REPLACE_ME_OPTIONAL_PUBLIC_URL
MAX_IMAGE_MB=5

# --- Payments (test mode) ---------------------------------------------------------
# auto = Stripe if its key is set, else Razorpay if its keys are set, else the built-in test gateway | stripe | razorpay | test
PAYMENT_PROVIDER=auto
# Option A: Stripe Connect
STRIPE_SECRET_KEY=REPLACE_ME_sk_test_xxx
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec_xxx
# Option B: Razorpay Route
RAZORPAY_KEY_ID=REPLACE_ME_rzp_test_xxx
RAZORPAY_KEY_SECRET=REPLACE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_RAZORPAY_WEBHOOK_SECRET

# --- Marketplace rules --------------------------------------------------------
# Share of each sale (goods after discount) the platform keeps. Shops can have their own rate, set by an admin.
PLATFORM_COMMISSION_PERCENT=10
# Three-letter currency code. Use inr with Razorpay.
CURRENCY=usd
# Shipping is charged per shop, in minor units (499 = 4.99). Free above the threshold.
SHIPPING_FLAT=499
FREE_SHIPPING_OVER=5000
